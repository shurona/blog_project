# 로컬 PostgreSQL 17 (~/workspace/infra-config/postgresql-17). 비밀번호는 compose 파일 참고
DATABASE_URL=postgresql://testuser:<비밀번호>@localhost:55533/golf_blog_local

# Better Auth: 세션 쿠키 서명용 비밀 키. `openssl rand -base64 32`로 만든 값을 넣는다
BETTER_AUTH_SECRET=<무작위 비밀 키>
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2: 사진 저장. 값은 Cloudflare 대시보드 > R2에서 확인한다
R2_ACCOUNT_ID=<계정 ID>
# API 토큰은 객체 읽기 및 쓰기 권한으로, 이 버킷에만 쓸 수 있게 만든다
R2_ACCESS_KEY_ID=<Access Key ID>
R2_SECRET_ACCESS_KEY=<Secret Access Key>
R2_BUCKET_NAME=<버킷 이름>
# 버킷의 공개 주소(개발용 r2.dev 주소 또는 연결한 도메인). 끝에 /를 붙이지 않는다
R2_PUBLIC_URL=https://pub-<값>.r2.dev
